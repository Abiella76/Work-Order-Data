# Customer data never enters version control.
#
# The daily reports carry customer names, vendor names, invoice numbers and
# dollar values. Drop them here to run the real-report assertions locally
# (see README, "Validating against the real reports"); they stay out of git.
/tests/fixtures-real/*.csv
/reports/
/tests/fixtures-real/expected.json

# The finance report's client revenue: real customer names and dollar values.
# The seed script reads it from the repo root by default; it must never be
# committed while this repository is public.
/client-revenue.csv
/client-revenue*.csv
/client-periods.json
