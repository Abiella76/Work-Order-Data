# Postgres connection string. `docker compose up -d` starts a local instance
# that matches this default; Neon and Supabase both hand you a URL in this form.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/work_orders

# Phase 4 — Gmail ingestion. Least-privilege: gmail.readonly, scoped by a
# sender/subject filter to the daily report mail only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# REPORT_SENDER=
